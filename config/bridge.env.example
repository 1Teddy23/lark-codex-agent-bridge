# Copy to config/bridge.env, then fill in the values.

# Optional legacy Cursor configuration. Codex does not need this key.
CURSOR_API_KEY=
CURSOR_MODEL=auto

# Codex adapter path, relative to the claw/ working directory used by start.ps1.
# Replace with an absolute path only when running a wrapper from elsewhere.
AGENT_BIN=../scripts/codex-agent-adapter.cmd

# Optional: stop a single Codex task after this many milliseconds.
# The default 0 means no adapter timeout.
CODEX_AGENT_TIMEOUT_MS=0

# Feishu/Lark Bot in WebSocket long-connection mode
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=

# Optional: user OAuth tokens for APIs that need user identity.
# Use scripts/feishu-user-oauth.js after adding the redirect URI in the Feishu console.
FEISHU_USER_ACCESS_TOKEN=
FEISHU_REFRESH_TOKEN=

# Optional: Volcengine speech-to-text / embeddings
VOLC_STT_APP_ID=
VOLC_STT_ACCESS_TOKEN=
VOLC_EMBEDDING_API_KEY=
VOLC_EMBEDDING_MODEL=doubao-embedding-vision-250615
